    private async Task SubmitReport()
    {
        if (product == null) return;
        reportError = null;
        submittingReport = true;
        await Task.Yield();

        var (ok, err, _) = Reports.SubmitReport(Session.Current.Id, Session.Current.Name, product.Id, product.Title, product.SellerId, Session.NameFor(product.SellerId), reportReason, reportDescription);
        if (!ok)
        {
            reportError = err;
            submittingReport = false;
            return;
        }

        submittingReport = false;
        showReportModal = false;
        statusFeedbackMessage = "Thank you. Your report has been submitted to administrators for review.";
