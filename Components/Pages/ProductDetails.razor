    private void MarkAsSoldByOwner()
    {
        if (product == null) return;
        var (ok, err) = Products.SetStatus(product.Id, Session.Current.Id, ProductStatus.Sold);
        if (ok)
        {
            statusFeedbackMessage = "Listing marked as Sold.";
            LoadProduct();
        }
        else
        {
            statusFeedbackMessage = err;
        }
    }
