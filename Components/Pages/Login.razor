@page "/login"
@inject DemoSession Session
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Sign In — ReTrade Marketplace</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Brand & Heading -->
        <div class="auth-header">
            <div class="auth-brand-badge" aria-hidden="true">R</div>
            <h1 class="auth-title">Welcome to ReTrade</h1>
            <p class="auth-subtitle">
                Access your marketplace listings, trade requests, and orders securely.
            </p>
        </div>

        @if (Session.IsAuthenticated)
        {
            <div class="alert alert-info auth-tab-alert">
                <div class="auth-tab-alert-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Tab Session Active</span>
                </div>
                <div class="auth-tab-alert-body">
                    Signed in as <strong>@Session.Current.Name</strong> (@Session.Current.Email)
                    <span class="badge badge-demo" style="margin-left:0.35rem">@Session.Current.Role</span>
                </div>
                <p class="auth-tab-alert-note">
                    This tab is isolated to your current session. Other browser tabs can sign in to separate accounts independently.
                </p>
                <div class="auth-tab-actions">
                    <a href="@(string.IsNullOrWhiteSpace(ReturnUrl) ? "dashboard" : ReturnUrl)" class="btn btn-primary btn-sm">
                        Go to Dashboard →
                    </a>
                    <button type="button" class="btn btn-outline btn-sm" @onclick="HandleLogout">
                        Sign Out of this Tab
                    </button>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(QueryError))
            {
                <div class="alert alert-error" role="alert" style="margin-bottom:1.25rem">
                    <strong>Sign-In Notice:</strong> @QueryError
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error" role="alert" style="margin-bottom:1.25rem">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="alert" style="margin-bottom:1.25rem">
                    @successMessage
                </div>
            }

            <!-- Social Authentication Section -->
            <div class="social-auth-grid">
                <!-- Google Sign-In Button -->
                <a href="@GetGoogleAuthUrl()" class="btn-social btn-google" title="Continue using your Google Account">
                    <svg class="social-icon" width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                        <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707 0-.59.102-1.167.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z"/>
                        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <!-- GitHub Sign-In Button -->
                <a href="@GetGitHubAuthUrl()" class="btn-social btn-github" title="Continue using your GitHub Account">
                    <svg class="social-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>Continue with GitHub</span>
                </a>
            </div>

            <!-- Visual Separator -->
            <div class="auth-divider" role="separator" aria-label="Or continue with email">
                <span>or continue with email</span>
            </div>

            <!-- Email & Password Login Form -->
            <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="field">
                    <label for="l-email">Email Address</label>
                    <input id="l-email" 
                           class="form-control" 
                           type="email" 
                           placeholder="name@example.com" 
                           @bind="email" 
                           autocomplete="username" 
                           required />
                </div>

                <div class="field">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem">
                        <label for="l-pass" style="margin-bottom:0">Password</label>
                    </div>
                    <div class="password-input-wrap">
                        <input id="l-pass" 
                               class="form-control" 
                               type="@(showPassword ? "text" : "password")" 
                               placeholder="••••••••" 
                               @bind="password" 
                               autocomplete="current-password" 
                               required />
                        <button type="button" 
                                class="password-toggle-btn" 
                                @onclick="TogglePasswordVisibility" 
                                aria-label="@(showPassword ? "Hide password" : "Show password")"
                                title="@(showPassword ? "Hide password" : "Show password")">
                            @if (showPassword)
                            {
                                <!-- Eye Off Icon (hide password) -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            }
                            else
                            {
                                <!-- Eye Icon (show password) -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="auth-options-row">
                    <label class="form-check" for="l-remember">
                        <input id="l-remember" type="checkbox" @bind="rememberMe" />
                        <span>Remember this tab</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:0.75rem" disabled="@isSubmitting">
                    @(isSubmitting ? "Signing In..." : "Sign In to Account")
                </button>
            </form>

            <div class="auth-footer-link">
                Don't have an account? <a href="register">Register new account →</a>
            </div>

            <!-- Quick Demo Accounts Helper for Multi-Tab Testing -->
            <div class="demo-login-helper">
                <div class="demo-helper-title">Testing Independent Sessions across Tabs:</div>
                <div class="demo-pills-row">
                    <button type="button" class="demo-pill-btn" @onclick='() => SetDemoCredentials("aarav@retrade.com", "Password@123")'>
                        Tab Account 1 (Aarav)
                    </button>
                    <button type="button" class="demo-pill-btn" @onclick='() => SetDemoCredentials("neha@retrade.com", "Password@123")'>
                        Tab Account 2 (Neha)
                    </button>
                    <button type="button" class="demo-pill-btn" @onclick='() => SetDemoCredentials("admin@retrade.com", "Admin@123")'>
                        Admin Account
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
.auth-wrapper {
    max-width: 480px;
    margin: 2.5rem auto;
    padding-inline: 1.25rem;
}

.auth-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 2.25rem 2rem;
    box-shadow: 0 4px 20px rgba(16, 32, 44, 0.05);
}

.auth-header {
    text-align: center;
    margin-bottom: 1.75rem;
}

.auth-brand-badge {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand) 0%, #14568f 100%);
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    box-shadow: 0 4px 12px rgba(27, 110, 194, 0.25);
}

.auth-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.35rem;
}

.auth-subtitle {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0;
}

.social-auth-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
}

.btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.68rem 1rem;
    border-radius: 10px;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.btn-social:hover {
    text-decoration: none;
}

.btn-google {
    background: #ffffff;
    color: #3c4043;
    border: 1px solid #dadce0;
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.08);
}

.btn-google:hover {
    background: #f8f9fa;
    border-color: #c6c9cc;
    color: #202124;
}

.btn-github {
    background: #24292f;
    color: #ffffff;
    border: 1px solid #24292f;
}

.btn-github:hover {
    background: #1b1f23;
    border-color: #1b1f23;
    color: #ffffff;
}

.social-icon {
    flex-shrink: 0;
}

.auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 1.4rem 0 1.25rem;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 500;
}

.auth-divider::before,
.auth-divider::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid var(--line);
}

.auth-divider span {
    padding-inline: 0.85rem;
}

.password-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.password-input-wrap input {
    padding-right: 2.75rem;
}

.password-toggle-btn {
    position: absolute;
    right: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
}

.password-toggle-btn:hover {
    color: var(--ink);
    background-color: #f1f5f9;
}

.auth-options-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block: 0.85rem 0.5rem;
}

.form-check {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    color: #334155;
    cursor: pointer;
    user-select: none;
}

.form-check input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    accent-color: var(--brand);
    cursor: pointer;
}

.auth-footer-link {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
}

.auth-footer-link a {
    font-weight: 600;
}

.auth-tab-alert {
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
}

.auth-tab-alert-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: #0c4a6e;
    margin-bottom: 0.25rem;
}

.auth-tab-alert-body {
    font-size: 0.9rem;
    color: #1e293b;
}

.auth-tab-alert-note {
    font-size: 0.84rem;
    color: #475569;
    margin: 0.45rem 0 0.85rem;
    line-height: 1.4;
}

.auth-tab-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.demo-login-helper {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--line);
    text-align: center;
}

.demo-helper-title {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748b;
    margin-bottom: 0.55rem;
}

.demo-pills-row {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    flex-wrap: wrap;
}

.demo-pill-btn {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
}

.demo-pill-btn:hover {
    background: #e2e8f0;
    color: var(--ink);
    border-color: #94a3b8;
}
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    private string email = "";
    private string password = "";
    private bool rememberMe = true;
    private bool showPassword = false;
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void SetDemoCredentials(string e, string p)
    {
        email = e;
        password = p;
        errorMessage = null;
    }

    private string GetGoogleAuthUrl()
    {
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl;
        return $"/auth/challenge/google?returnUrl={Uri.EscapeDataString(target)}";
    }

    private string GetGitHubAuthUrl()
    {
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl;
        return $"/auth/challenge/github?returnUrl={Uri.EscapeDataString(target)}";
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        successMessage = null;
        isSubmitting = true;

        var (ok, err) = await Session.LoginAsync(email, password);
        isSubmitting = false;

        if (!ok)
        {
            errorMessage = err;
            return;
        }

        successMessage = $"Welcome back, {Session.Current.Name}!";

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Nav.NavigateTo(ReturnUrl);
        }
        else if (Session.Current.IsAdmin)
        {
            Nav.NavigateTo("admin");
        }
        else
        {
            Nav.NavigateTo("dashboard");
        }
    }

    private async Task HandleLogout()
    {
        await Session.LogoutAsync();
        errorMessage = null;
        successMessage = "You have been signed out from this browser tab.";
    }
}
